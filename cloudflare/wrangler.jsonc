{
  "name": "emc-magnific",
  "main": "worker.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "../dist-cf/public", "binding": "ASSETS", "run_worker_first": true},
  "alias": {
    "@/app/chatgpt-auth": "./shims/chatgpt-auth.ts",
    "@/lib/connectors": "./shims/connectors.ts"
  },
  "d1_databases": [
    {"binding": "DB", "database_name": "emc-magnific", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../drizzle"}
  ],
  "triggers": {"crons": ["* * * * *"]},
  "observability": {"enabled": true}
}
